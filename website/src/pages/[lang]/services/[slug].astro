---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { t, localize, langs, type Lang } from '../../../i18n';
import { getServices, slugOf, type Service } from '../../../lib/services';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    const services = await getServices(lang);
    for (const service of services) {
      paths.push({ params: { lang, slug: slugOf(service) }, props: { service, services } });
    }
  }
  return paths;
}

interface Props {
  service: Service;
  services: Service[];
}

const lang = Astro.params.lang as Lang;
const { service, services } = Astro.props;
const d = t(lang);
const { title, summary, pillar, icon, highlights } = service.data;
const { Content } = await render(service);
const related = services.filter((s) => s.data.pillar === pillar && s.id !== service.id);
---

<Base lang={lang} title={title} description={summary}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={d.services.title}>
        <a href={localize('/services/', lang)}>{d.services.title}</a>
        <span aria-hidden="true">/</span>
        <a href={localize(`/services/#${pillar}`, lang)}>{d.pillars[pillar]}</a>
      </nav>
      <div class="page-hero-title">
        <span class="hero-icon"><Icon name={icon} /></span>
        <h1>{title}</h1>
      </div>
      <p class="lead">{summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <article class="prose">
        <Content />
      </article>

      <aside class="detail-aside">
        <div class="aside-card">
          <h2>{d.services.included}</h2>
          <ul class="check-list">
            {highlights.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="aside-card aside-card-dark">
          <h2>{d.services.discussHeading}</h2>
          <p>{d.services.discussText}</p>
          <a class="btn btn-primary btn-block" href={localize('/contact/', lang)}>{d.services.discussButton}</a>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-soft" aria-labelledby="related-title">
      <div class="container">
        <div class="section-head section-head-row">
          <h2 id="related-title">{d.services.related}</h2>
          <a class="text-link" href={localize('/services/', lang)}>
            {d.services.all} <Icon name="arrow" class="flip-rtl" />
          </a>
        </div>
        <div class="card-grid">
          {related.map((s) => <ServiceCard service={s} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand lang={lang} />
</Base>
